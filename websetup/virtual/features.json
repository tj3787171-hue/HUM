{
  "$schema": "./schemas/features.schema.json",
  "phase": "virtual",
  "version": 1,
  "description": "Feature toggles for virtual-setup phase.",
  "features": {
    "compose_v2": {
      "enabled": true
    },
    "libvirt": {
      "enabled": false,
      "uri": "qemu:///system"
    },
    "multicast_lab": {
      "enabled": true
    },
    "macsec_lab": {
      "enabled": false
    },
    "sdv_apply_before_virtual": {
      "enabled": true
    },
    "require_docker0": {
      "enabled": true
    },
    "lvm_location_services": {
      "enabled": true,
      "matrix_node": "location-services",
      "result_mode": "interactive"
    },
    "lvm_encrypted_cloud_services": {
      "enabled": true,
      "matrix_node": "encrypted-cloud-services",
      "encryption_required": true,
      "action_mode": "automatic"
    },
    "bind_bridge_tokens": {
      "enabled": true,
      "matrix_node": "desktop-server",
      "script": "scripts/hum_bind_bridge.py",
      "units_allow": [
        "snapper-timeline.service",
        "snapperd.service",
        "fwupd.service",
        "fwupd-refresh.service"
      ],
      "units_deny": [
        "phpsessionclean.service",
        "apt-listchanges.service"
      ],
      "plymouth": {
        "mode": "join",
        "wait_unit": "plymouth-quit-wait.service",
        "quit_unit": "plymouth-quit.service",
        "timeout_sec": 20,
        "perl_unit": "apt-listchanges.service"
      },
      "image_roles": [
        "linux-amd64-iso",
        "darwin-kernel-dmg",
        "iso-image"
      ]
    }
  }
}
