# Private devcontainer environment overrides.
.devcontainer/dev.env

# Local runtime artifacts generated from imported env values.
.devcontainer/*.local.json
__pycache__/
*.pyc
data/
!site/circuits/data/
!site/circuits/data/**
diagnostics/
iso-build/.build/

# Built artifacts
dist/*.iso

# Local SQL login database (never commit password hashes).
site/login/var/*.sqlite
site/login/var/*.sqlite-*

# Broadcast TLS material (public cert is generated locally; never commit the key).
site/broadcast/var/tls/
