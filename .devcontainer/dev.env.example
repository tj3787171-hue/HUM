#
# Copy this file to `.devcontainer/dev.env` and keep real values private.
# The `.devcontainer/dev.env` file is gitignored.
#
# Begin clone + authenticated cert setup by filling PATH variables here,
# then: bash .devcontainer/import-environment.sh
#       python3 scripts/hum_clone_cert_bootstrap.py begin
# Put certificate files outside git. These variables are paths, not PEM bodies.
#

# Human-readable owner marker for runtime metadata.
HUM_OWNER_TAG=local-user

# Keep virtual desktop and browser debug listeners local by default.
HUM_VDESK_BIND=127.0.0.1
HUM_VDESK_PORT=6080
HUM_VNC_PORT=5901
HUM_CHROME_REMOTE_DEBUG_ADDR=127.0.0.1
HUM_CHROME_REMOTE_DEBUG_PORT=9222

# Optional proxy import from host/Penguin terminal.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal
ALL_PROXY=

# Required clone root for HUM and dependency checkouts (created by `begin`).
HUM_CLONE_ROOT=~/src
HUM_REPO_URL=https://github.com/tj3787171-hue/HUM.git
HUM_ISO_DIR=
HUM_DMG_DIR=

# Authenticated TLS paths for HTTPS serve, git, fwupd/LVFS, and Cursor CLI.
# Leave empty until the files exist; `begin` treats non-empty values as underway.
HUM_TLS_CERT=
HUM_TLS_KEY=
HUM_TLS_CA=
SSL_CERT_FILE=
GIT_SSL_CAINFO=
NODE_EXTRA_CA_CERTS=
REQUESTS_CA_BUNDLE=
CURL_CA_BUNDLE=
