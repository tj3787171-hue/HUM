# Exact boot-crash and skip catalog for hum-recovery-access.sh
# Fields: kind<TAB>unit<TAB>role
# kind: crash = report as boot-crash candidate; skip = never touch
crash	plymouth-quit-wait.service	boot-block
crash	fwupd.service	firmware-update
crash	fwupd.socket	firmware-update
crash	fwupd-refresh.service	firmware-update
crash	fwupd-refresh.timer	firmware-update
crash	systemd-binfmt.service	binfmt
crash	proc-sys-fs-binfmt_misc.mount	binfmt
crash	proc-sys-fs-binfmt_misc.automount	binfmt
skip	institute-hikvision-probe.service	do-not-touch
